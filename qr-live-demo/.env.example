# The public URL where this app will be deployed (used to generate the QR code).
# For local testing you can point this at your machine's LAN IP, e.g. http://192.168.1.10:3000
# For Render, this will be something like: https://qr-live-demo.onrender.com
SITE_URL=http://localhost:3000

# Port the server listens on (Render sets this automatically, so this is mostly for local dev)
PORT=3000

# Simple shared password to view/act on the /dashboard admin actions (clear visitors, export CSV).
# Change this before your session!
ADMIN_KEY=tinkerhub2026
